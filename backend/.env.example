# --- App ---
ENV=development
DEBUG=true

# --- Database (Uses psycopg v3: postgresql+psycopg://) ---
DATABASE_URL="postgresql+psycopg://username:password@localhost:5432/documind"
# For Supabase/Neon connection pooler:
# DATABASE_URL="postgresql+psycopg://postgres.projectref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Auth ---
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage Abstraction ---
# Development:
STORAGE_BACKEND=local

# Production with Vercel Blob:
# STORAGE_BACKEND=vercel_blob
# BLOB_READ_WRITE_TOKEN=<set-in-deployment-platform>

# Production with S3 / Cloudflare R2 / MinIO:
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=<set-in-deployment-platform>
# S3_ACCESS_KEY_ID=<set-in-deployment-platform>
# S3_SECRET_ACCESS_KEY=<set-in-deployment-platform>
# S3_ENDPOINT_URL=
# S3_REGION=auto

# --- Serverless Execution ---
# Set to true on Vercel to process PDFs synchronously rather than using BackgroundTasks
SYNC_DOCUMENT_PROCESSING=false

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Vision ---
VISION_PROVIDER=groq
VISION_MODEL=llama-3.2-90b-vision-preview
VISION_API_KEY=

# --- Embeddings ---
# Embedding model.
# Recommended for Render 512MB RAM: sentence-transformers/all-MiniLM-L6-v2 (~80MB, fast CPU inference)
# Multilingual options: intfloat/multilingual-e5-small | intfloat/multilingual-e5-large
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Vector store ---
VECTOR_STORE=faiss
FAISS_INDEX_DIR=./storage/faiss

# --- OCR ---
TESSERACT_CMD=tesseract

# --- Uploads (used by local storage) ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=50
